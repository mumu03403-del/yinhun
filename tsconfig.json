{
  // Base configuration. Do not edit this field.
  // cc / cc-env 的类型声明改由编辑器首次导入工程时生成的 ./temp/tsconfig.cocos.json 提供。
  // 原文中硬编码的 "paths"（cc -> ./temp/declarations/cc）指向并不存在的目录（死路径），
  // 已按官方 empty-2d 模板写法移除，改由基线配置接管。
  "extends": "./temp/tsconfig.cocos.json",

  // Add your custom configuration here.
  "compilerOptions": {
    "strict": false
  }
}

